{
  "hooks": {
    "Stop": [{
      "matcher": "",
      "hooks": [{"type": "command", "command": "bash .claude/hooks/workflow-continue.sh"}]
    }],
    "PreCompact": [{
      "matcher": "",
      "hooks": [{"type": "command", "command": "bash .claude/hooks/workflow-snapshot.sh"}]
    }],
    "SessionStart": [{
      "matcher": "compact",
      "hooks": [{"type": "command", "command": "bash .claude/hooks/workflow-reinject.sh"}]
    }]
  }
}

